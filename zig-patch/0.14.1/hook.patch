+/// air2lean (zig-patch): illegal behaviour that Sema does not check with runtime safety off,
+/// made visible to the AIR exporter as `if (!ok) unreachable` (`air_json_unchecked_ib`).
+fn air2leanUncheckedIb(sema: *Sema, block: *Block, ok: Air.Inst.Ref) CompileError!void {
+    var fail_block = block.makeSubBlock();
+    defer fail_block.instructions.deinit(sema.gpa);
+    _ = try fail_block.addNoOp(.unreach);
+    try sema.addSafetyCheckExtra(block, ok, &fail_block);
+}
+
+/// The unchecked illegal behaviours this compiler lowers to `unreach` (`air2leanUncheckedIb`).
+pub const air_json_unchecked_ib = [_][]const u8{"for_len"};
 
