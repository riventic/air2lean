  obtain ⟨v0, args, rfl, h0, h⟩ := argsOk_cons h
  obtain ⟨v1, args, rfl, h1, h⟩ := argsOk_cons h
  obtain rfl := argsOk_nil h
  replace h0 : valOk (.int false 32) v0 = true := h0
  rw [valOk_int h0]
  replace h1 : valOk (.int false 32) v1 = true := h1
  rw [valOk_int h1]
  funext m
  show (execFunc program gen air_tardiness _).run m = (gen _ _).run m
  rw [tardiness_step gen (v0.toBV 32) (v1.toBV 32)]
  simp only [gen, air_sem]

/-- The generated program satisfies every certified function's AIR equation. -/
theorem gen_fixpoint : Fixpoint program gen table :=
  ⟨(by intro f args hp ha; rw [lookup_absDiff] at hp; cases hp; exact absDiff_fix args ha), (by intro f args hp ha; rw [lookup_clampAdd] at hp; cases hp; exact clampAdd_fix args ha), (by intro f args hp ha; rw [lookup_classify] at hp; cases hp; exact classify_fix args ha), (by intro f args hp ha; rw [lookup_scale] at hp; cases hp; exact scale_fix args ha), (by intro f args hp ha; rw [lookup_tardiness] at hp; cases hp; exact tardiness_fix args ha), trivial⟩

/-- The AIR semantics restricted to the certified names, using the complete original
program's lookup and cost policy, is below the
generated program: every terminating AIR behaviour is the generated definition's. -/
theorem run_le_gen : Lean.Order.PartialOrder.rel (runOn program table) gen :=
  run_le_of_table gen_fixpoint

/-- `basic.absDiff` makes no certified call: its AIR semantics equals the generated definition. -/
theorem absDiff_run (p0 : BitVec 32) (p1 : BitVec 32) (m : Zig.Mem) :
    (runOn program table "basic.absDiff" [(Value.int true 32 p0), (Value.int true 32 p1)]).run m =
      (fun v => ((Value.int false 32 v), m)) <$> Basic.absDiff p0 p1 := by
  rw [runOn_of_lookup (by decide) lookup_absDiff]
  exact absDiff_step _ p0 p1 m

theorem absDiff_complete (p0 : BitVec 32) (p1 : BitVec 32) (m : Zig.Mem) :
    Lean.Order.PartialOrder.rel ((fun v => ((Value.int false 32 v), m)) <$> Basic.absDiff p0 p1)
      ((runOn program table "basic.absDiff" [(Value.int true 32 p0), (Value.int true 32 p1)]).run m) :=
  rel_of_eq (absDiff_run p0 p1 m).symm

