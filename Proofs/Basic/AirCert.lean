  conv => rhs; rw [Basic.sum]
  simp only [air_sum_body, air_sum_types, air_sum_layouts, air_sum_params, air_sem, enc_sum, policy_sum, entry_sum, source_4, execFuncV, view_sum, len_of_size hs0, hs0, sum_loop7, Env.val, Frame.cell]
  all_goals repeat (first
    | rfl
    | (refine bind_congr_ok _ _ (fun r hr => sum_loop7_exits a0 p0 hs0 _ _ r hr) ?_
       rintro ⟨e, s⟩ ⟨h1, h2⟩
       cases e <;> simp (config := { failIfUnchanged := false }) only [air_sum_body, air_sum_types, air_sum_layouts, air_sum_params, air_sem, enc_sum, policy_sum, entry_sum, source_4, execFuncV, view_sum, len_of_size hs0, hs0, Env.val, Frame.cell, Exit.again, exitOk] at h1 h2 ⊢)
    | (refine bind_congr fun _ => ?_))

/-- `basic.sum`, called with the items its caller read (`Zig.readSlice`, from `m`): the AIR
semantics has the generated definition's values and errors, and its memory is `m` up to read
entries of the running thread (`UpToReads`). -/
theorem sum_step (call : Oracle) (p0 : Zig.Slice) (m : Zig.Mem) (hwf : m.ClockWf)
    (a0 : Array (BitVec 32)) (m0 : Zig.Mem)
    (r0 : ((Zig.readSlice (BitVec 32) 4 p0).run m).run = some (.ok (a0, m0))) :
    RelR (fun p q => p.1 = q.1 ∧ UpToReads m p.2 ∧ q.2 = m)
      ((execFunc program call air_sum [Value.slice p0]).run m)
      ((fun v => ((Value.int false 64 v), m)) <$> Basic.sum a0) := by
  obtain ⟨v0, hs0, -⟩ := holds_of_readSlice (f := air_sum) (t := 8) (a := 4)
    (fun x => (Value.int false 32 x)) r0 hwf (fun q al => by simp only [air_sum, air_sem, source_4])
    (fun size al h => by
      simp only [air_sum, air_sem, source_4, Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      decide)
  rw [← sum_view call p0 a0 hs0 m]
  refine execFunc_view program m air_sum _ call (view_sum a0) viewTy_sum
    (by simp only [roBody, roNested, roCases, roInst, argAt, air_sum, air_sem, source_4, view_sum, viewTy_sum,
      List.find?_cons, List.find?_nil, cond_true, cond_false, Option.isSome_some])
    ⟨by simp [Value.noPtr], ?_⟩ policy_sum
  intro k items idx t hk ha
  simp only [view_sum] at hk
  split at hk
  · cases hk
    subst_vars
    rw [show argAt air_sum 0 = some (0, 0) from rfl] at ha
    cases ha
    exact ⟨p0, 4, rfl, rfl, v0, by simp [Value.noPtr]⟩
  all_goals cases hk

