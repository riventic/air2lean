  replace h1 : valOk (.int true 32) v1 = true := h1
  rw [valOk_int h1]
  funext m
  show (execFunc program gen air_absDiff _).run m = (gen _ _).run m
  rw [absDiff_step gen (v0.toBV 32) (v1.toBV 32)]
  simp only [gen, air_sem]

