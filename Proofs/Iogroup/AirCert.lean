      ("Io.Mutex.lockUncancelable", { loop := true, entry := false }),
      ("Io.Mutex.tryLock", { loop := true, entry := false }),
      ("Io.Mutex.unlock", { loop := true, entry := false }),
      ("debug.assert", { loop := false, entry := false }),
      ("iogroup.add", { loop := true, entry := false }),
      ("iogroup.groupConcurrent", { loop := true, entry := false }),
      ("iogroup.groupCounter", { loop := true, entry := false })] := by
  decide +kernel

/-- The decoded canonical AIR of `debug.assert` in the original program. -/
def air_debug_assert : _root_.Air2Lean.Func := source_4

theorem lookup_debug_assert : program.lookup "debug.assert" = some air_debug_assert := rfl
theorem policy_debug_assert : program.ticked "debug.assert" = false :=
  congrArg _root_.Air2Lean.TickPolicy.loop (_root_.Air2Lean.Program.tickPolicy_of_tickPolicies policies 4 (by decide))
theorem entry_debug_assert : program.entryTicked "debug.assert" = false :=
  congrArg _root_.Air2Lean.TickPolicy.entry (_root_.Air2Lean.Program.tickPolicy_of_tickPolicies policies 4 (by decide))

theorem callee_0 : panicOf? "debug.FullPanic((function 'defaultPanic')).reachedUnreachable" = some .unreachable := rfl

/-- The certified functions, by fully qualified name. -/
def table : Table := [
  "debug.assert"]

/-- The generated definitions as a call oracle (arguments decoded by type). -/
def gen : Oracle
  | "debug.assert", args =>
    StateT.lift ((fun _ => Value.void) <$> Iogroup.debug_assert ((args.getD 0 .void).toBool))
  | _, _ => StateT.lift stuck

/-- `debug.assert`: the AIR semantics of the decoded function (under any call oracle) equals the generated definition. -/
theorem debug_assert_step (call : Oracle) (p0 : Bool) (m : Zig.Mem) :
    (execFunc program call air_debug_assert [(Value.bool p0)]).run m =
      (fun _ => (Value.void, m)) <$> Iogroup.debug_assert p0 := by
  conv => rhs; rw [Iogroup.debug_assert]
  simp only [air_debug_assert, air_sem, policy_debug_assert, entry_debug_assert, source_4, callee_0]

theorem debug_assert_fix (args : List Value)
    (h : argsOk air_debug_assert air_debug_assert.params.toList args = true) :
    execFunc program gen air_debug_assert args = gen "debug.assert" args := by
  replace h : argsOk air_debug_assert [0] args = true := h
  obtain ⟨v0, args, rfl, h0, h⟩ := argsOk_cons h
  obtain rfl := argsOk_nil h
  replace h0 : valOk .bool v0 = true := h0
  rw [valOk_bool h0]
  funext m
  show (execFunc program gen air_debug_assert _).run m = (gen _ _).run m
  rw [debug_assert_step gen v0.toBool]
  simp only [gen, air_sem]

/-- The generated program satisfies every certified function's AIR equation. -/
theorem gen_fixpoint : Fixpoint program gen table :=
  ⟨(by intro f args hp ha; rw [lookup_debug_assert] at hp; cases hp; exact debug_assert_fix args ha), trivial⟩

/-- The AIR semantics restricted to the certified names, using the complete original
program's lookup and cost policy, is below the
generated program: every terminating AIR behaviour is the generated definition's. -/
theorem run_le_gen : Lean.Order.PartialOrder.rel (runOn program table) gen :=
  run_le_of_table gen_fixpoint

/-- `debug.assert` makes no certified call: its AIR semantics equals the generated definition. -/
theorem debug_assert_run (p0 : Bool) (m : Zig.Mem) :
    (runOn program table "debug.assert" [(Value.bool p0)]).run m =
      (fun _ => (Value.void, m)) <$> Iogroup.debug_assert p0 := by
  rw [runOn_of_lookup (by decide) lookup_debug_assert]
  exact debug_assert_step _ p0 m

theorem debug_assert_complete (p0 : Bool) (m : Zig.Mem) :
    Lean.Order.PartialOrder.rel ((fun _ => (Value.void, m)) <$> Iogroup.debug_assert p0)
      ((runOn program table "debug.assert" [(Value.bool p0)]).run m) :=
  rel_of_eq (debug_assert_run p0 m).symm

end Iogroup.AirCert
