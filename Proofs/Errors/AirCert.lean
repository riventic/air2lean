    #[("errors.digitOrZero", { loop := false, entry := false }),
      ("errors.parseDigit", { loop := false, entry := false }),
      ("errors.sumDigits", { loop := false, entry := false })] := by
  decide +kernel

/-- The decoded canonical AIR of `errors.digitOrZero` in the original program. -/
def air_digitOrZero : _root_.Air2Lean.Func := source_0

theorem lookup_digitOrZero : program.lookup "errors.digitOrZero" = some air_digitOrZero := rfl
theorem policy_digitOrZero : program.ticked "errors.digitOrZero" = false :=
  congrArg _root_.Air2Lean.TickPolicy.loop (_root_.Air2Lean.Program.tickPolicy_of_tickPolicies policies 0 (by decide))
theorem entry_digitOrZero : program.entryTicked "errors.digitOrZero" = false :=
  congrArg _root_.Air2Lean.TickPolicy.entry (_root_.Air2Lean.Program.tickPolicy_of_tickPolicies policies 0 (by decide))

/-- The decoded canonical AIR of `errors.parseDigit` in the original program. -/
def air_parseDigit : _root_.Air2Lean.Func := source_1

theorem lookup_parseDigit : program.lookup "errors.parseDigit" = some air_parseDigit := rfl
theorem policy_parseDigit : program.ticked "errors.parseDigit" = false :=
  congrArg _root_.Air2Lean.TickPolicy.loop (_root_.Air2Lean.Program.tickPolicy_of_tickPolicies policies 1 (by decide))
theorem entry_parseDigit : program.entryTicked "errors.parseDigit" = false :=
  congrArg _root_.Air2Lean.TickPolicy.entry (_root_.Air2Lean.Program.tickPolicy_of_tickPolicies policies 1 (by decide))

theorem callee_0 : panicOf? "errors.parseDigit" = none := rfl

/-- The certified functions, by fully qualified name. -/
def table : Table := [
  "errors.digitOrZero",
  "errors.parseDigit"]

/-- The generated definitions as a call oracle (arguments decoded by type). -/
def gen : Oracle
  | "errors.digitOrZero", args =>
    StateT.lift ((fun v => (Value.int false 8 v)) <$> Errors.digitOrZero ((args.getD 0 .void).toBV 8))
  | "errors.parseDigit", args =>
    StateT.lift ((fun v => (Value.ofExcept (fun x => (Value.int false 8 x)) v)) <$> Errors.parseDigit ((args.getD 0 .void).toBV 8))
  | _, _ => StateT.lift stuck

/-- `errors.digitOrZero`: the AIR semantics of the decoded function, with the generated program answering its calls, equals the generated definition. -/
theorem digitOrZero_step (p0 : BitVec 8) (m : Zig.Mem) :
    (execFunc program gen air_digitOrZero [(Value.int false 8 p0)]).run m =
      (fun v => ((Value.int false 8 v), m)) <$> Errors.digitOrZero p0 := by
  conv => rhs; rw [Errors.digitOrZero]
  simp only [air_digitOrZero, air_sem, policy_digitOrZero, entry_digitOrZero, source_0, callee_0, gen]

theorem digitOrZero_fix (args : List Value)
    (h : argsOk air_digitOrZero air_digitOrZero.params.toList args = true) :
    execFunc program gen air_digitOrZero args = gen "errors.digitOrZero" args := by
  replace h : argsOk air_digitOrZero [0] args = true := h
  obtain ⟨v0, args, rfl, h0, h⟩ := argsOk_cons h
  obtain rfl := argsOk_nil h
  replace h0 : valOk (.int false 8) v0 = true := h0
  rw [valOk_int h0]
  funext m
  show (execFunc program gen air_digitOrZero _).run m = (gen _ _).run m
  rw [digitOrZero_step (v0.toBV 8)]
  simp only [gen, air_sem]

/-- `errors.parseDigit`: the AIR semantics of the decoded function (under any call oracle) equals the generated definition. -/
theorem parseDigit_step (call : Oracle) (p0 : BitVec 8) (m : Zig.Mem) :
    (execFunc program call air_parseDigit [(Value.int false 8 p0)]).run m =
      (fun v => ((Value.ofExcept (fun x => (Value.int false 8 x)) v), m)) <$> Errors.parseDigit p0 := by
  conv => rhs; rw [Errors.parseDigit]
  simp only [air_parseDigit, air_sem, policy_parseDigit, entry_parseDigit, source_1]

theorem parseDigit_fix (args : List Value)
    (h : argsOk air_parseDigit air_parseDigit.params.toList args = true) :
    execFunc program gen air_parseDigit args = gen "errors.parseDigit" args := by
  replace h : argsOk air_parseDigit [0] args = true := h
  obtain ⟨v0, args, rfl, h0, h⟩ := argsOk_cons h
  obtain rfl := argsOk_nil h
  replace h0 : valOk (.int false 8) v0 = true := h0
  rw [valOk_int h0]
  funext m
  show (execFunc program gen air_parseDigit _).run m = (gen _ _).run m
  rw [parseDigit_step gen (v0.toBV 8)]
  simp only [gen, air_sem]

/-- The generated program satisfies every certified function's AIR equation. -/
theorem gen_fixpoint : Fixpoint program gen table :=
  ⟨(by intro f args hp ha; rw [lookup_digitOrZero] at hp; cases hp; exact digitOrZero_fix args ha), (by intro f args hp ha; rw [lookup_parseDigit] at hp; cases hp; exact parseDigit_fix args ha), trivial⟩

/-- The AIR semantics restricted to the certified names, using the complete original
program's lookup and cost policy, is below the
generated program: every terminating AIR behaviour is the generated definition's. -/
theorem run_le_gen : Lean.Order.PartialOrder.rel (runOn program table) gen :=
  run_le_of_table gen_fixpoint

/-- `errors.parseDigit` makes no certified call: its AIR semantics equals the generated definition. -/
theorem parseDigit_run (p0 : BitVec 8) (m : Zig.Mem) :
    (runOn program table "errors.parseDigit" [(Value.int false 8 p0)]).run m =
      (fun v => ((Value.ofExcept (fun x => (Value.int false 8 x)) v), m)) <$> Errors.parseDigit p0 := by
  rw [runOn_of_lookup (by decide) lookup_parseDigit]
  exact parseDigit_step _ p0 m

theorem parseDigit_complete (p0 : BitVec 8) (m : Zig.Mem) :
    Lean.Order.PartialOrder.rel ((fun v => ((Value.ofExcept (fun x => (Value.int false 8 x)) v), m)) <$> Errors.parseDigit p0)
      ((runOn program table "errors.parseDigit" [(Value.int false 8 p0)]).run m) :=
  rel_of_eq (parseDigit_run p0 m).symm

/-- `errors.digitOrZero`: every terminating AIR run is the generated definition's. -/
theorem digitOrZero_sound (p0 : BitVec 8) (m : Zig.Mem) :
    Lean.Order.PartialOrder.rel ((runOn program table "errors.digitOrZero" [(Value.int false 8 p0)]).run m)
      ((fun v => ((Value.int false 8 v), m)) <$> Errors.digitOrZero p0) := by
  have h : Lean.Order.PartialOrder.rel ((runOn program table "errors.digitOrZero" [(Value.int false 8 p0)]).run m)
      ((gen "errors.digitOrZero" [(Value.int false 8 p0)]).run m) := run_le_gen "errors.digitOrZero" [(Value.int false 8 p0)] m
  simp only [gen, air_sem] at h
  exact h

/-- `errors.digitOrZero`: the generated definition terminates only as the AIR does: it is below `run`. -/
theorem digitOrZero_complete (p0 : BitVec 8) (m : Zig.Mem) :
    Lean.Order.PartialOrder.rel ((fun v => ((Value.int false 8 v), m)) <$> Errors.digitOrZero p0)
      ((runOn program table "errors.digitOrZero" [(Value.int false 8 p0)]).run m) := by
  have h_complete : (fun g => ∀ (a0 : BitVec 8) (m : Zig.Mem), True → Lean.Order.PartialOrder.rel ((fun v => ((Value.int false 8 v), m)) <$> g a0) ((runOn program table "errors.digitOrZero" [(Value.int false 8 a0)]).run m)) ((fun (v0 : BitVec 8) => Errors.digitOrZero v0)) := by
    intro a0 m hfixed
    conv => lhs; delta Errors.digitOrZero
    rw [runOn_of_lookup (by decide) lookup_digitOrZero]
    simp (config := { failIfUnchanged := false }) only [air_sem, id_map', air_digitOrZero, policy_digitOrZero, entry_digitOrZero, source_0, callee_0, Env.val, Frame.cell]
    all_goals repeat (first
      | exact Lean.Order.PartialOrder.rel_refl
      | exact parseDigit_complete _ _
      | (refine Lean.Order.PartialOrder.rel_trans ?_ (Lean.Order.MonoBind.bind_mono_left (parseDigit_complete _ _))
         simp only [bind_map_left]
         first
         | refine bind_le_ok _ (fun _ => True) (fun _ _ => True.intro) ?_
         | (conv => lhs; rw [← bind_pure_comp]
            refine bind_le_ok _ (fun _ => True) (fun _ _ => True.intro) ?_)
         intro r _
         cases r <;> simp (config := { failIfUnchanged := false }) only [air_sem, id_map', air_digitOrZero, policy_digitOrZero, entry_digitOrZero, source_0, callee_0, Env.val, Frame.cell])
      | (refine map_bind_le_ok _ _ Lean.Order.PartialOrder.rel_refl (fun _ => True) (fun _ _ => True.intro) ?_
         intro r _; simp (config := { failIfUnchanged := false }) only [air_sem, id_map', air_digitOrZero, policy_digitOrZero, entry_digitOrZero, source_0, callee_0, Env.val, Frame.cell])
      | (split <;> simp (config := { failIfUnchanged := false }) only [air_sem, id_map', air_digitOrZero, policy_digitOrZero, entry_digitOrZero, source_0, callee_0, Env.val, Frame.cell, *])
      | (simp only [map_bind]; apply Lean.Order.MonoBind.bind_mono_right; intro)
      | (apply Lean.Order.MonoBind.bind_mono_right; intro))
  exact h_complete p0 m (by simp)

/-- `errors.digitOrZero`: its AIR semantics equals the generated definition. -/
theorem digitOrZero_eq (p0 : BitVec 8) (m : Zig.Mem) :
    (runOn program table "errors.digitOrZero" [(Value.int false 8 p0)]).run m =
      (fun v => ((Value.int false 8 v), m)) <$> Errors.digitOrZero p0 :=
  Lean.Order.PartialOrder.rel_antisymm (digitOrZero_sound p0 m) (digitOrZero_complete p0 m)

end Errors.AirCert
