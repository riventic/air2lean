    {"premise": "THR-05", "scope": "closure", "pattern": "[Ff]utex"},
    {"premise": "THR-06", "scope": "closure", "pattern": "osUnfairLock|DarwinImpl"},
    {"premise": "THR-07", "scope": "closure", "pattern": "spinLoopHint|threadYield"},
    {"premise": "THR-09", "scope": "closure", "pattern": "(?:^|\\.)Cooperative(?:\\.|$)"},
    {"premise": "ORD-01", "scope": "closure", "pattern": "atomic(?:Load|Store|Rmw)|cmpxchg|AtomicOrder|RmwOp"},
    {"premise": "ORD-03", "scope": "closure", "pattern": "seqCst"},
    {"premise": "ORD-04", "scope": "closure", "pattern": "cmpxchgWeak|WeakCas"},
    {"premise": "TMR-01", "scope": "closure", "pattern": "Deadline|time_Timer|timedWait"},
    {"premise": "TMR-02", "scope": "closure", "pattern": "TimedSched|AwakeEnvironment|NoCancellation"},
    {"premise": "ENV-02", "scope": "closure", "pattern": "(?:^|\\.)(?:monotonicNow|wallNow)$"},
    {"premise": "MTH-02", "scope": "closure", "pattern": "(?:^|\\.)libm(?:\\.|$)"},
    {"premise": "MTH-03", "scope": "closure", "pattern": "Rt016|(?:^|\\.)mulRt$|RtChk"},
    {"premise": "ASM-01", "scope": "closure", "pattern": "(?:^|\\.)airAsm_[0-9]+$"},
