    {
      "cases": 346,
      "classification": "stage2-x86_64-float-mod-rounding",
      "example": "floatops",
      "function": "op16/op32/op64/op80/op128 (sel 8, @mod)",
      "note": "Float @mod with operands of opposite sign where the LLVM lowering frem(frem(a, b) + b, b) and the self-hosted backend round differently (e.g. @mod(-2^-24 as f16, 1.0) is 0 under LLVM and the model, 1.0 under stage2_x86_64). The model follows the LLVM lowering, so this is a backend divergence on a legal input, in every optimize mode.",
      "reproducer": "tests/roadmap/build-modes/reproducers/stage2-x86_64-divergences.zig"
    },
    {
      "cases": 2,
      "classification": "stage2-x86_64-f80-signed-zero-minmax",
      "example": "floatops",
      "function": "op80 (sel 16 and 17, @min and @max)",
      "note": "f80 @min(-0.0, +0.0) and @max(-0.0, +0.0): the model and LLVM order the signed zeros, stage2_x86_64 returns the other zero. The language leaves the order of signed zeros unspecified, so this may be a model over-specification rather than a backend defect.",
      "reproducer": "tests/roadmap/build-modes/reproducers/stage2-x86_64-divergences.zig"
    },
    {
      "cases": 173,
      "classification": "stage2-x86_64-narrow-int-extension",
      "example": "layout",
      "function": "setNib, nibArg",
      "note": "An i4 read from a packed union and returned is not sign-extended by stage2_x86_64 (returns 8 where LLVM and the model return -8). A backend defect on a legal input, in every optimize mode.",
      "reproducer": "tests/roadmap/build-modes/reproducers/stage2-x86_64-divergences.zig"
    },
    {
      "cases": 85,
      "classification": "illegal-behaviour-not-detected-by-releasesafe",
      "example": "floatops",
      "function": "divExact64",
      "note": "Each input has a non-integral quotient, which @divExact makes illegal. ReleaseSafe does not check float @divExact and returns the truncated quotient, which the model reproduces without throwing; ReleaseFast and ReleaseSmall return the plain quotient. The ReleaseFast no-illegal-behaviour-transfer premise (a model that does not throw implies legal execution) therefore does not hold for float @divExact.",
      "reproducer": "tests/roadmap/build-modes/reproducers/float-divexact-inexact.zig"
    }
  ],
  "zig_version": "0.16.0"
