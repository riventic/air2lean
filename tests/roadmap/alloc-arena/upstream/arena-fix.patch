+/// `alignForward(base + n, 2)`, the size of a node whose buffer ends `n` bytes after `base`, or
+/// `null` if that does not fit in `usize`.
+fn nodeSizeFor(base: usize, n: usize) ?usize {
+    const size = std.math.add(usize, base, n) catch return null;
+    return mem.alignBackward(usize, std.math.add(usize, size, 1) catch return null, 2);
