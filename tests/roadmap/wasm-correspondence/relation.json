 "kernels": {
  "des_time_add32": {
   "class": "exact",
   "domains": [
    "u64",
    "u64"
   ],
   "why": "u32 arithmetic and an error union of fixed width: no pointer-width, float or ABI dependence."
  },
  "des_time_add64": {
   "class": "exact",
   "domains": [
    "u64",
    "u64"
   ],
   "why": "u64 arithmetic: wasm32 has native i64 operations; no pointer-width dependence."
  },
  "des_event_before": {
   "class": "exact",
   "domains": [
    "u64",
    "u64",
    "u64",
    "u64"
   ],
   "edge_cap": 300,
   "random": 200,
   "why": "integer comparisons only."
  },
  "des_queue_drain": {
   "class": "exact",
   "domains": [
    "u64",
    "count"
   ],
   "why": "the heap indices are usize but bounded by 32, below both widths' limits; the array is a stack local."
  },
  "int_mix": {
   "class": "exact",
   "domains": [
    "u64",
    "u64"
   ],
   "why": "fixed-width wrapping arithmetic and bit builtins; u128 is lowered by both backends exactly."
  },
  "int_divmod": {
   "class": "exact",
   "domains": [
    "u64",
    "u64"
   ],
   "why": "i64 division: division by zero and minInt / -1 are safety panics on both targets."
  },
  "int_add_checked": {
   "class": "exact",
   "domains": [
    "u64",
    "u64"
   ],
   "why": "u64 overflow is a safety panic on both targets."
  },
  "int_shl_exact": {
   "class": "exact",
   "domains": [
    "u64",
    "shift"
   ],
   "why": "a shift amount >= 64 fails the u6 cast (a safety panic) on both targets."
  },
  "usize_bits": {
   "class": "target-specific",
   "domains": [],
   "expect": "bits",
   "why": "@bitSizeOf(usize) is the profile's pointer width."
  },
  "pw_byte_count": {
   "class": "target-specific",
   "domains": [
    "u64"
   ],
   "expect": "NONE if a >= 2 ** bits or 4 * a >= 2 ** bits else 4 * a",
   "why": "pointer_width.byteCount overflows at 2^bits (PRF-04): theorems byteCount_w32 and byteCount_x64."
  },
  "pw_succ": {
   "class": "target-specific",
   "domains": [
    "u64"
   ],
   "expect": "TRAP if a % 2 ** bits == 2 ** bits - 1 else a % 2 ** bits + 1",
   "why": "pointer_width.succ overflows at 2^bits - 1 (PRF-04): theorems succ_w32 and succ_x64."
  },
  "f64_arith": {
   "class": "tolerated",
   "format": "f64",
   "ulp": 0,
   "domains": [
    "f64",
    "f64"
   ],
   "why": "IEEE-754 binary64 +, *, / are correctly rounded on both; a NaN's sign and payload are not specified (wasm32 may canonicalize)."
  },
  "f64_sqrt": {
   "class": "tolerated",
   "format": "f64",
   "ulp": 0,
   "domains": [
    "f64"
   ],
   "why": "sqrt is correctly rounded (sqrtsd, fsqrt, f64.sqrt); NaN sign and payload are not specified."
  },
  "f32_fma": {
   "class": "tolerated",
   "format": "f32",
   "ulp": 0,
   "domains": [
    "f32",
    "f32",
    "f32"
   ],
   "random": 200,
   "why": "@mulAdd rounds once on both (an instruction natively, compiler_rt fmaf on wasm32); NaN sign and payload are not specified."
  },
  "f64_sin": {
   "class": "tolerated",
   "format": "f64",
   "ulp": 1,
   "domains": [
    "f64"
   ],
   "random": 200,
   "why": "@sin is a libm call (compiler_rt, or the platform libm on macOS): faithfully rounded, not correctly rounded (MTH-02)."
  },
  "f64_to_i64": {
   "class": "exact",
   "domains": [
    "f64"
   ],
   "random": 200,
   "why": "truncation toward zero is exact, and an out-of-range operand is a safety panic on both (0.15.2 on). A NaN (every version), and an out-of-range operand before 0.15.2 (no safety check), are illegal behaviour that safe mode does not detect (docs/floats.md): x86_64 returns minInt, aarch64 and wasm32 return 0 or saturate.",
   "illegal": "(a >> 52) & 2047 == 2047 and a & (2 ** 52 - 1) != 0 or zig < 15 and (a >> 52) & 2047 >= 1086 and a != 0xc3e0000000000000"
  }
 },
 "claims": [
  {
   "kernel": "pw_byte_count",
   "target": "wasm32-freestanding",
   "theorem": "PointerWidth.Proofs.byteCount_w32",
   "file": "tests/roadmap/pointer-width/PointerWidth/Proofs.lean"
  },
  {
   "kernel": "pw_byte_count",
   "target": "x86_64-linux",
   "theorem": "PointerWidth.Proofs.byteCount_x64",
   "file": "tests/roadmap/pointer-width/PointerWidth/Proofs.lean"
  },
  {
   "kernel": "pw_succ",
   "target": "wasm32-freestanding",
   "theorem": "PointerWidth.Proofs.succ_w32",
   "file": "tests/roadmap/pointer-width/PointerWidth/Proofs.lean"
  },
  {
   "kernel": "pw_succ",
   "target": "x86_64-linux",
   "theorem": "PointerWidth.Proofs.succ_x64",
   "file": "tests/roadmap/pointer-width/PointerWidth/Proofs.lean"
  }
 ]
