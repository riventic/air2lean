{
  "exports": [
    {
      "out": "air/{version}/lists",
      "source": "../../../examples/lists/lists.zig",
      "filter": "lists.,mem.,math.,array_list.,debug.assert,debug.SafetyLock",
      "versions": ["0.17.0", "0.16.0", "0.15.2", "0.14.1"],
      "args": ["-OReleaseSafe", "-fno-error-tracing", "-target", "x86_64-linux", "-mcpu=baseline"],
      "cwd": "repo",
      "closure": ["lists.push", "lists.reverse", "lists.freeAll", "lists.sum", "lists.evens"]
    },
    {
      "out": "air/{version}/mix",
      "source": "mix.zig",
      "filter": "mix.,mem.,math.,heap.FixedBufferAllocator,debug.assert",
      "versions": ["0.17.0", "0.16.0", "0.15.2", "0.14.1"],
      "args": ["-OReleaseSafe", "-fno-error-tracing", "-target", "x86_64-linux", "-mcpu=baseline"],
      "cwd": "repo",
      "closure": ["mix.make", "mix.withFba"]
    },
    {
      "out": "air/{version}/rnd",
      "source": "rnd.zig",
      "filter": "rnd.,Random.",
      "versions": ["0.17.0", "0.16.0", "0.15.2", "0.14.1"],
      "args": ["-OReleaseSafe", "-fno-error-tracing", "-target", "x86_64-linux", "-mcpu=baseline"],
      "cwd": "repo",
      "closure": ["rnd.roll"]
    },
    {
      "out": "air/{version}/sentinel",
      "source": "../sentinel-realloc/source.zig",
      "filter": "source.,mem.,math.,debug.assert",
      "versions": ["0.17.0", "0.16.0", "0.15.2", "0.14.1"],
      "args": ["-OReleaseSafe", "-fno-error-tracing", "-target", "x86_64-linux", "-mcpu=baseline"],
      "cwd": "repo",
      "closure": ["source.make", "source.append", "source.resize", "source.release"]
    }
  ]
}
