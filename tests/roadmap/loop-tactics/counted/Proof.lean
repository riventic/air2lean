import Counted.Inv
import ZigLean.Sep.Full.Loop
import ZigLean.Sep.Full.Auto
import ZigLean.Sep.Full.Tick

/-!
# Translated counted loops with generated invariants, in the full-state logic

`Counted/Gen.lean` is the committed translation of `counted.zig` (retained AIR in `air/`, checked
byte for byte by `check.sh`). Each function runs one loop of one shape of the counted family
(`docs/invariant-synthesis.md`): a counter that goes down (`down`), a `!=` test (`upNe`), a `<=`
test (`upLe`), the length of a slice as bound (`lenCount`) and a bound read through a pointer in
every iteration (`readBound`). Their invariants `F.loop5.inv` and measures `F.loop5.meas` are
generated by `air2lean-invgen` into `Counted/Inv.lean`; `check.sh` regenerates them and checks that
seeded mutants of them fail.

For each loop: `F_step`, one run of the body by `fsym`; `F_loop`, the loop by
`FTotalTriple.loop_measure`, as a rule for `fsym`; `F_total`, the function by `fsym [F_loop]`.
Only the specifications (the step's exit branch, the loop's and the function's triples) are
written here. Every body run takes a step (`Zig.tick`), so the invariants carry the plain mode.

Two loops of `counted.zig` are outside the family, and `Counted/Inv.lean` records why: `pairAt`
writes cells at offsets of its parameter (`Zig.ptrProject`) and `tri` adds the counter to its cell.
-/

namespace Counted.Proof
open Zig Zig.Full Zig.Full.FAssn Zig.Full.Auto

/-- `*p` holds `x`. -/
def acc (p : Ptr) (x : Nat) : FAssn := FAssn.ex fun v : BitVec 64 => ⟪v.toNat = x⟫ ⋆ up (pts p 8 v)

/-! ## `down`: `while (i > 0) : (i -= 1) acc.* += 3` -/

theorem down_step (p : Ptr) (w : BitVec 64) (s0 s : downLocals) :
    FTotalTriple (down.loop5.inv p s0 w s) ((down.loop5 p).run s)
      (fun r => if down.again5 r.1 then ⟪down.loop5.meas p r.2 < down.loop5.meas p s⟫ ⋆ down.loop5.inv p s0 w r.2
        else ⟪r.1 = .br4⟫ ⋆ (acc p (w.toNat + 3 * s0.i.toNat) ⋆ plain)) := by
  unfold down.loop5 down.loop5.inv down.loop5.meas acc
  fsym

theorem down_loop {mb : Lean.Order.MonoBind (MM downLocals)} (p : Ptr) (w : BitVec 64) (s : downLocals)
    (hfit : w.toNat + 3 * s.i.toNat < 2 ^ 64) :
    FTotalTriple (up (pts p 8 w) ⋆ plain)
      ((@Zig.loop (MM downLocals) _ _ mb _ (down.loop5 p) down.again5).run s)
      (fun r => FAssn.ex fun t : downLocals => ⟪r = (.br4, t)⟫ ⋆ (acc p (w.toNat + 3 * s.i.toNat) ⋆ plain)) :=
  (FTotalTriple.loop_measure (down.loop5.inv p s w) (down.loop5.meas p) _ (down_step p w s) s).eupd
    (by unfold down.loop5.inv; fsym_entail)
    |>.eupd_post fun ⟨e, t⟩ => EUpd.of_imp fun _ h => by
      obtain ⟨he, h⟩ := sep_lift.mp h
      exact ⟨t, sep_lift.mpr ⟨by simp only at he; rw [he], h⟩⟩

/-- `down` adds `3 * n` to `*acc`, under the premise that the sum fits. -/
theorem down_total (p : Ptr) (n : BitVec 32) (v : BitVec 64) (hfit : v.toNat + 3 * n.toNat < 2 ^ 64) :
    FTotalTriple (up (pts p 8 v) ⋆ plain) (down p n)
      (fun _ => up (pts p 8 (BitVec.ofNat 64 (v.toNat + 3 * n.toNat))) ⋆ plain) := by
  unfold down
  fsym [down_loop]

/-! ## `upNe`: `while (i != n) : (i += 1) acc.* += 1` -/

theorem upNe_step (p : Ptr) (n : BitVec 32) (w : BitVec 64) (s0 s : upNeLocals) :
    FTotalTriple (upNe.loop5.inv p n s0 w s) ((upNe.loop5 p n).run s)
      (fun r => if upNe.again5 r.1 then ⟪upNe.loop5.meas p n r.2 < upNe.loop5.meas p n s⟫ ⋆ upNe.loop5.inv p n s0 w r.2
        else ⟪r.1 = .br4⟫ ⋆ (acc p (w.toNat + (n.toNat - s0.i.toNat)) ⋆ plain)) := by
  unfold upNe.loop5 upNe.loop5.inv upNe.loop5.meas acc
  fsym

theorem upNe_loop {mb : Lean.Order.MonoBind (MM upNeLocals)} (p : Ptr) (n : BitVec 32) (w : BitVec 64)
    (s : upNeLocals) (hi : s.i.toNat ≤ n.toNat) (hfit : w.toNat + (n.toNat - s.i.toNat) < 2 ^ 64) :
    FTotalTriple (up (pts p 8 w) ⋆ plain)
      ((@Zig.loop (MM upNeLocals) _ _ mb _ (upNe.loop5 p n) upNe.again5).run s)
      (fun r => FAssn.ex fun t : upNeLocals => ⟪r = (.br4, t)⟫ ⋆
        (acc p (w.toNat + (n.toNat - s.i.toNat)) ⋆ plain)) :=
  (FTotalTriple.loop_measure (upNe.loop5.inv p n s w) (upNe.loop5.meas p n) _ (upNe_step p n w s) s).eupd
    (by unfold upNe.loop5.inv; fsym_entail)
    |>.eupd_post fun ⟨e, t⟩ => EUpd.of_imp fun _ h => by
      obtain ⟨he, h⟩ := sep_lift.mp h
      exact ⟨t, sep_lift.mpr ⟨by simp only at he; rw [he], h⟩⟩

/-- `upNe` adds `n` to `*acc`, under the premise that the sum fits. -/
theorem upNe_total (p : Ptr) (n : BitVec 32) (v : BitVec 64) (hfit : v.toNat + n.toNat < 2 ^ 64) :
    FTotalTriple (up (pts p 8 v) ⋆ plain) (upNe p n)
      (fun _ => up (pts p 8 (BitVec.ofNat 64 (v.toNat + n.toNat))) ⋆ plain) := by
  unfold upNe
  fsym [upNe_loop]

/-! ## `upLe`: `while (i <= n) : (i += 1) acc.* += 1` -/

theorem upLe_step (p : Ptr) (n : BitVec 32) (w : BitVec 64) (s0 s : upLeLocals) :
    FTotalTriple (upLe.loop5.inv p n s0 w s) ((upLe.loop5 p n).run s)
      (fun r => if upLe.again5 r.1 then ⟪upLe.loop5.meas p n r.2 < upLe.loop5.meas p n s⟫ ⋆ upLe.loop5.inv p n s0 w r.2
        else ⟪r.1 = .br4⟫ ⋆ (acc p (w.toNat + (n.toNat + 1 - s0.i.toNat)) ⋆ plain)) := by
  unfold upLe.loop5 upLe.loop5.inv upLe.loop5.meas acc
  fsym

theorem upLe_loop {mb : Lean.Order.MonoBind (MM upLeLocals)} (p : Ptr) (n : BitVec 32) (w : BitVec 64)
    (s : upLeLocals) (hi : s.i.toNat ≤ n.toNat + 1) (hn : n.toNat + 1 < 2 ^ 32)
    (hfit : w.toNat + (n.toNat + 1 - s.i.toNat) < 2 ^ 64) :
    FTotalTriple (up (pts p 8 w) ⋆ plain)
      ((@Zig.loop (MM upLeLocals) _ _ mb _ (upLe.loop5 p n) upLe.again5).run s)
      (fun r => FAssn.ex fun t : upLeLocals => ⟪r = (.br4, t)⟫ ⋆
        (acc p (w.toNat + (n.toNat + 1 - s.i.toNat)) ⋆ plain)) :=
  (FTotalTriple.loop_measure (upLe.loop5.inv p n s w) (upLe.loop5.meas p n) _ (upLe_step p n w s) s).eupd
    (by unfold upLe.loop5.inv; fsym_entail)
    |>.eupd_post fun ⟨e, t⟩ => EUpd.of_imp fun _ h => by
      obtain ⟨he, h⟩ := sep_lift.mp h
      exact ⟨t, sep_lift.mpr ⟨by simp only at he; rw [he], h⟩⟩

/-- `upLe` adds `n + 1` to `*acc`, under the premises that `n + 1` and the sum fit (`n` the
largest `u32` makes `i += 1` overflow). -/
theorem upLe_total (p : Ptr) (n : BitVec 32) (v : BitVec 64) (hn : n.toNat + 1 < 2 ^ 32)
    (hfit : v.toNat + (n.toNat + 1) < 2 ^ 64) :
    FTotalTriple (up (pts p 8 v) ⋆ plain) (upLe p n)
      (fun _ => up (pts p 8 (BitVec.ofNat 64 (v.toNat + (n.toNat + 1)))) ⋆ plain) := by
  unfold upLe
  fsym [upLe_loop]

/-! ## `lenCount`: `while (i < xs.len) : (i += 1) acc.* += 1` -/

theorem lenCount_step (p : Ptr) (xs : Slice) (w : BitVec 64) (s0 s : lenCountLocals) :
    FTotalTriple (lenCount.loop5.inv p xs s0 w s) ((lenCount.loop5 p xs).run s)
      (fun r => if lenCount.again5 r.1 then
          ⟪lenCount.loop5.meas p xs r.2 < lenCount.loop5.meas p xs s⟫ ⋆ lenCount.loop5.inv p xs s0 w r.2
        else ⟪r.1 = .br4⟫ ⋆ (acc p (w.toNat + (xs.len.toNat - s0.i.toNat)) ⋆ plain)) := by
  unfold lenCount.loop5 lenCount.loop5.inv lenCount.loop5.meas acc
  fsym

theorem lenCount_loop {mb : Lean.Order.MonoBind (MM lenCountLocals)} (p : Ptr) (xs : Slice) (w : BitVec 64)
    (s : lenCountLocals) (hi : s.i.toNat ≤ xs.len.toNat) (hfit : w.toNat + (xs.len.toNat - s.i.toNat) < 2 ^ 64) :
    FTotalTriple (up (pts p 8 w) ⋆ plain)
      ((@Zig.loop (MM lenCountLocals) _ _ mb _ (lenCount.loop5 p xs) lenCount.again5).run s)
      (fun r => FAssn.ex fun t : lenCountLocals => ⟪r = (.br4, t)⟫ ⋆
        (acc p (w.toNat + (xs.len.toNat - s.i.toNat)) ⋆ plain)) :=
  (FTotalTriple.loop_measure (lenCount.loop5.inv p xs s w) (lenCount.loop5.meas p xs) _
    (lenCount_step p xs w s) s).eupd
    (by unfold lenCount.loop5.inv; fsym_entail)
    |>.eupd_post fun ⟨e, t⟩ => EUpd.of_imp fun _ h => by
      obtain ⟨he, h⟩ := sep_lift.mp h
      exact ⟨t, sep_lift.mpr ⟨by simp only at he; rw [he], h⟩⟩

/-- `lenCount` adds the length of `xs` to `*acc`, under the premise that the sum fits. -/
theorem lenCount_total (p : Ptr) (xs : Slice) (v : BitVec 64) (hfit : v.toNat + xs.len.toNat < 2 ^ 64) :
    FTotalTriple (up (pts p 8 v) ⋆ plain) (lenCount p xs)
      (fun _ => up (pts p 8 (BitVec.ofNat 64 (v.toNat + xs.len.toNat))) ⋆ plain) := by
  unfold lenCount
  fsym [lenCount_loop]

/-! ## `readBound`: `while (i < lim.*) : (i += 1) acc.* += 1` -/

theorem readBound_step (p q : Ptr) (lim : BitVec 32) (w : BitVec 64) (s0 s : readBoundLocals) :
    FTotalTriple (readBound.loop5.inv p q s0 lim w s) ((readBound.loop5 p q).run s)
      (fun r => if readBound.again5 r.1 then
          ⟪readBound.loop5.meas p q lim r.2 < readBound.loop5.meas p q lim s⟫ ⋆ readBound.loop5.inv p q s0 lim w r.2
        else ⟪r.1 = .br4⟫ ⋆ (up (pts q 4 lim) ⋆ (acc p (w.toNat + (lim.toNat - s0.i.toNat)) ⋆ plain))) := by
  unfold readBound.loop5 readBound.loop5.inv readBound.loop5.meas acc
  fsym

theorem readBound_loop {mb : Lean.Order.MonoBind (MM readBoundLocals)} (p q : Ptr) (lim : BitVec 32)
    (w : BitVec 64) (s : readBoundLocals) (hi : s.i.toNat ≤ lim.toNat)
    (hfit : w.toNat + (lim.toNat - s.i.toNat) < 2 ^ 64) :
    FTotalTriple (up (pts q 4 lim) ⋆ (up (pts p 8 w) ⋆ plain))
      ((@Zig.loop (MM readBoundLocals) _ _ mb _ (readBound.loop5 p q) readBound.again5).run s)
      (fun r => FAssn.ex fun t : readBoundLocals => ⟪r = (.br4, t)⟫ ⋆
        (up (pts q 4 lim) ⋆ (acc p (w.toNat + (lim.toNat - s.i.toNat)) ⋆ plain))) :=
  (FTotalTriple.loop_measure (readBound.loop5.inv p q s lim w) (readBound.loop5.meas p q lim) _
    (readBound_step p q lim w s) s).eupd
    (by unfold readBound.loop5.inv; fsym_entail)
    |>.eupd_post fun ⟨e, t⟩ => EUpd.of_imp fun _ h => by
      obtain ⟨he, h⟩ := sep_lift.mp h
      exact ⟨t, sep_lift.mpr ⟨by simp only at he; rw [he], h⟩⟩

/-- `readBound` adds `*lim` to `*acc` and keeps `*lim`, under the premise that the sum fits. -/
theorem readBound_total (p q : Ptr) (lim : BitVec 32) (v : BitVec 64) (hfit : v.toNat + lim.toNat < 2 ^ 64) :
    FTotalTriple (up (pts q 4 lim) ⋆ (up (pts p 8 v) ⋆ plain)) (readBound p q)
      (fun _ => up (pts q 4 lim) ⋆ (up (pts p 8 (BitVec.ofNat 64 (v.toNat + lim.toNat))) ⋆ plain)) := by
  unfold readBound
  fsym [readBound_loop]

end Counted.Proof

-- Only the standard axioms: no `sorryAx`, no `native_decide` (`Lean.ofReduceBool`).
/-- info: 'Counted.Proof.down_total' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms Counted.Proof.down_total
