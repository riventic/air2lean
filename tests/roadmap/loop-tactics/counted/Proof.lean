import Counted.Inv
import ZigLean.Sep.Full.Auto
import ZigLean.Sep.Full.Tick

/-!
# Translated counted loops with generated invariants, in the full-state logic

`Counted/Gen.lean` is the committed translation of `counted.zig` (retained AIR in `air/`, checked
byte for byte by `check.sh`). Each function runs one loop of one shape of the counted family
(`docs/invariant-synthesis.md`): a counter that goes down (`down`), a `!=` test (`upNe`), a `<=`
test (`upLe`), the length of a slice as bound (`lenCount`) and a bound read through a pointer in
every iteration (`readBound`). Their invariants `F.loop5.inv`, measures `F.loop5.meas` and exit
posts `F.loop5.post` are generated by `air2lean-invgen` into `Counted/Inv.lean` and registered
with `@[fsym_inv]`; `check.sh` regenerates them and checks that seeded mutants of them fail.

Each function is proved by `fsym` alone: at the loop it applies `FTotalTriple.loop_measure` with
the registered definitions, plans the invariant at the entry and walks one run of the body. Only
the functions' specifications are written here. Every body run takes a step (`Zig.tick`), so the
invariants carry the plain mode.

Two loops of `counted.zig` are outside the family, and `Counted/Inv.lean` records why: `pairAt`
writes cells at offsets of its parameter (`Zig.ptrProject`) and `tri` adds the counter to its cell.
-/

namespace Counted.Proof
open Zig Zig.Full Zig.Full.FAssn Zig.Full.Auto

/-- `down` (`while (i > 0) : (i -= 1) acc.* += 3`) adds `3 * n` to `*acc`, under the premise that
the sum fits. -/
theorem down_total (p : Ptr) (n : BitVec 32) (v : BitVec 64) (hfit : v.toNat + 3 * n.toNat < 2 ^ 64) :
    FTotalTriple (up (pts p 8 v) ⋆ plain) (down p n)
      (fun _ => up (pts p 8 (BitVec.ofNat 64 (v.toNat + 3 * n.toNat))) ⋆ plain) := by
  unfold down
  fsym

/-- `upNe` (`while (i != n) : (i += 1) acc.* += 1`) adds `n` to `*acc`, under the premise that the
sum fits. -/
theorem upNe_total (p : Ptr) (n : BitVec 32) (v : BitVec 64) (hfit : v.toNat + n.toNat < 2 ^ 64) :
    FTotalTriple (up (pts p 8 v) ⋆ plain) (upNe p n)
      (fun _ => up (pts p 8 (BitVec.ofNat 64 (v.toNat + n.toNat))) ⋆ plain) := by
  unfold upNe
  fsym

/-- `upLe` (`while (i <= n) : (i += 1) acc.* += 1`) adds `n + 1` to `*acc`, under the premises
that `n + 1` and the sum fit (`n` the largest `u32` makes `i += 1` overflow). -/
theorem upLe_total (p : Ptr) (n : BitVec 32) (v : BitVec 64) (hn : n.toNat + 1 < 2 ^ 32)
    (hfit : v.toNat + (n.toNat + 1) < 2 ^ 64) :
    FTotalTriple (up (pts p 8 v) ⋆ plain) (upLe p n)
      (fun _ => up (pts p 8 (BitVec.ofNat 64 (v.toNat + (n.toNat + 1)))) ⋆ plain) := by
  unfold upLe
  fsym

/-- `lenCount` (`while (i < xs.len) : (i += 1) acc.* += 1`) adds the length of `xs` to `*acc`,
under the premise that the sum fits. -/
theorem lenCount_total (p : Ptr) (xs : Slice) (v : BitVec 64) (hfit : v.toNat + xs.len.toNat < 2 ^ 64) :
    FTotalTriple (up (pts p 8 v) ⋆ plain) (lenCount p xs)
      (fun _ => up (pts p 8 (BitVec.ofNat 64 (v.toNat + xs.len.toNat))) ⋆ plain) := by
  unfold lenCount
  fsym

/-- `readBound` (`while (i < lim.*) : (i += 1) acc.* += 1`) adds `*lim` to `*acc` and keeps
`*lim`, under the premise that the sum fits. -/
theorem readBound_total (p q : Ptr) (lim : BitVec 32) (v : BitVec 64) (hfit : v.toNat + lim.toNat < 2 ^ 64) :
    FTotalTriple (up (pts q 4 lim) ⋆ (up (pts p 8 v) ⋆ plain)) (readBound p q)
      (fun _ => up (pts q 4 lim) ⋆ (up (pts p 8 (BitVec.ofNat 64 (v.toNat + lim.toNat))) ⋆ plain)) := by
  unfold readBound
  fsym

end Counted.Proof

-- Only the standard axioms: no `sorryAx`, no `native_decide` (`Lean.ofReduceBool`).
/-- info: 'Counted.Proof.down_total' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms Counted.Proof.down_total
