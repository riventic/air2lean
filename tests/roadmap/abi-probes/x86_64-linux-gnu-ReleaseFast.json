{
  "name": "abi64-le-v1",
  "target_triple": "x86_64-linux-gnu",
  "pointer_bits": 64,
  "endian": "little",
  "abi": "gnu",
  "zig_version": "0.16.0",
  "backend": "stage2_llvm",
  "cpu": "x86_64",
  "features": [
    "64bit",
    "cmov",
    "cx8",
    "fxsr",
    "idivq_to_divl",
    "macrofusion",
    "mmx",
    "nopl",
    "slow_3ops_lea",
    "slow_incdec",
    "sse",
    "sse2",
    "vzeroupper",
    "x87"
  ],
  "build_mode": "ReleaseFast",
  "float_mode": "per-instruction",
  "error_set_bits": 16,
  "error_layout": "type-table",
  "error_tracing": false,
  "export_stage": "analyzed-air"
}
