{
  "exports": [
    {
      "out": "air/{version}",
      "source": "error_tracing.zig",
      "filter": "error_tracing.bigRet,error_tracing.pass,error_tracing.traceIndex,error_tracing.traced,error_tracing.handledTwice,builtin.returnError,lang.returnError",
      "versions": [
        "0.17.0",
        "0.16.0",
        "0.15.2",
        "0.14.1"
      ],
      "args": [
        "-OReleaseSafe",
        "-ferror-tracing",
        "-target",
        "x86_64-linux",
        "-mcpu=baseline"
      ],
      "cwd": "repo"
    }
  ]
}
